# MLflow tracking server — copy to .env and fill in your values.
# .env is git-ignored; never commit credentials.
#
# These variables are read automatically by the experiment runner if python-dotenv
# is installed (included in the [exp] extra).  They can also be set as regular
# shell environment variables; the .env file is only a convenience.
#
# YAML config keys (mlflow.tracking_uri / mlflow.username / mlflow.password)
# take precedence over these env vars when both are set.

# Remote MLflow tracking server URL.
# Leave unset to use the local ./mlruns directory.
MLFLOW_TRACKING_URI=https://mlflow.example.com

# HTTP Basic / token-based auth (MLflow ≥ 2.x with auth plugin, or MLflow behind a proxy).
MLFLOW_TRACKING_USERNAME=your_username
MLFLOW_TRACKING_PASSWORD=your_password
